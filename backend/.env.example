# ==========================================
#  文枢 Wenshu · 本地配置
# ==========================================

APP_NAME=文枢
APP_VERSION=1.5.6
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
TZ=Asia/Shanghai

# ---------- 数据库（SQLite，绝对路径）----------
DATABASE_URL=sqlite+aiosqlite:///X:/小说工程/wenshu/runtime/data/wenshu.db

# ---------- 运行时目录（指向代码目录之外）----------
MUMU_DATA_DIR=X:\小说工程\wenshu\runtime\data

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE_PATH=X:\小说工程\wenshu\runtime\logs\wenshu.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=30

# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# ---------- 模型 ----------
# 不填也能启动：改写回退本地规则，体检不依赖模型
OPENAI_API_KEY=sk-SET_ME
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_AI_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=32000
ALLOW_PRIVATE_AI_ENDPOINTS=true
ALLOWED_AI_HOSTS=127.0.0.1,localhost

# ---------- 本地身份（无登录模式）----------
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_USERNAME=local
LOCAL_AUTH_DISPLAY_NAME=本机用户
SESSION_COOKIE_SECURE=false

# ---------- 关闭邮件 ----------
EMAIL_AUTH_ENABLED=false
EMAIL_REGISTER_ENABLED=false

# ---------- 提示词工坊 ----------
WORKSHOP_MODE=client
